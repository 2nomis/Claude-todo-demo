{
  "signatur": "1a8aded4cd20",
  "dauer": 111.04,
  "saetze": [
    {
      "n": 1,
      "text": "AirPods können ein Flugzeugtriebwerk verstummen lassen, und sie blockieren den Schall nicht einmal.",
      "schluessel": "verstummen",
      "anfang": 0,
      "ende": 5.32
    },
    {
      "n": 2,
      "text": "Wohin geht also der Lärm?",
      "schluessel": "Lärm",
      "anfang": 5.6,
      "ende": 7.2
    },
    {
      "n": 3,
      "text": "Nirgendwohin. Denn deine AirPods entfernen den Lärm gar nicht: Sie spielen einen zweiten Ton darüber.",
      "schluessel": "zweiten",
      "anfang": 7.52,
      "ende": 13.8
    },
    {
      "n": 4,
      "text": "Sie hören dem Lärm zu und spielen sein genaues Gegenteil.",
      "schluessel": "Gegenteil",
      "anfang": 14.08,
      "ende": 17.44
    },
    {
      "n": 5,
      "text": "Stell dir vor, du sitzt im Flugzeug, und das Triebwerk ist ein einziges, langes, tiefes Dröhnen.",
      "schluessel": "Dröhnen",
      "anfang": 18.08,
      "ende": 23.84
    },
    {
      "n": 6,
      "text": "Schall ist nur Luft, die an deinem Trommelfell drückt und zieht, hunderte Male pro Sekunde.",
      "schluessel": "Trommelfell",
      "anfang": 24.48,
      "ende": 29.52
    },
    {
      "n": 7,
      "text": "Außen an jedem AirPod sitzt ein winziges Mikrofon, und es hört dieses Dröhnen einen Sekundenbruchteil, bevor es dein Ohr erreicht.",
      "schluessel": "Mikrofon",
      "anfang": 30.16,
      "ende": 38
    },
    {
      "n": 8,
      "text": "Ein Chip nimmt diese Welle und dreht sie auf den Kopf.",
      "schluessel": "Kopf",
      "anfang": 38.64,
      "ende": 41.48
    },
    {
      "n": 9,
      "text": "Wo das Triebwerk drückt, zieht der Lautsprecher in deinem Ohr, genau gleich stark.",
      "schluessel": "zieht",
      "anfang": 41.76,
      "ende": 46.56
    },
    {
      "n": 10,
      "text": "Apple nennt das Anti-Lärm.",
      "schluessel": "Anti-Lärm",
      "anfang": 47.12,
      "ende": 48.72
    },
    {
      "n": 11,
      "text": "Die beiden Wellen treffen sich in deinem Ohr und heben sich auf.",
      "schluessel": "auf",
      "anfang": 49.28,
      "ende": 52.4
    },
    {
      "n": 12,
      "text": "Dein Trommelfell bewegt sich kaum, und genau das hörst du als Stille.",
      "schluessel": "Stille",
      "anfang": 52.88,
      "ende": 57.04
    },
    {
      "n": 13,
      "text": "Aber die Kopie ist nie perfekt.",
      "schluessel": "perfekt",
      "anfang": 57.36,
      "ende": 59.48
    },
    {
      "n": 14,
      "text": "Deshalb gibt es ein zweites Mikrofon, innen, das auf dein Ohr zeigt. Es hört den Lärm, der übrig bleibt, und löscht auch den.",
      "schluessel": "innen",
      "anfang": 59.76,
      "ende": 67.12
    },
    {
      "n": 15,
      "text": "Bei den ersten AirPods Pro wurde das laut Apple 200 Mal pro Sekunde korrigiert.",
      "schluessel": "200",
      "anfang": 67.44,
      "ende": 72.76
    },
    {
      "n": 16,
      "text": "Deshalb löschen sie ein Triebwerk aus, aber nicht die Person, die neben dir redet.",
      "schluessel": "redet",
      "anfang": 73.04,
      "ende": 77.6
    },
    {
      "n": 17,
      "text": "Ein gleichmäßiger, tiefer Ton ist leicht vorherzusagen. Eine Stimme ändert sich zu schnell, um rechtzeitig umgedreht zu werden.",
      "schluessel": "Stimme",
      "anfang": 77.92,
      "ende": 85.64
    },
    {
      "n": 18,
      "text": "Und deshalb ist der Sitz so wichtig. Wenn der Aufsatz dein Ohr nicht abdichtet, dringt der Lärm daran vorbei.",
      "schluessel": "Sitz",
      "anfang": 85.92,
      "ende": 92.32
    },
    {
      "n": 19,
      "text": "In den Einstellungen deines iPhones gibt es einen Test dafür: den Ohreinsatz-Passformtest.",
      "schluessel": "Ohreinsatz-Passformtest",
      "anfang": 92.64,
      "ende": 98.32
    },
    {
      "n": 20,
      "text": "Deine AirPods blockieren also nicht die Welt. Sie spielen ihr genaues Gegenteil, und beides zusammen ergibt: nichts.",
      "schluessel": "nichts",
      "anfang": 98.64,
      "ende": 106.24
    },
    {
      "n": 21,
      "text": "Folg mir und schick das jemandem, der seine AirPods nie herausnimmt.",
      "schluessel": "nie",
      "anfang": 106.28,
      "ende": 110.24
    }
  ],
