  "saetze": [
    {
      "n": 1,
      "text": "Why is the hook on your tape measure loose?",
      "schluessel": "loose",
      "anfang": 0,
      "ende": 2.32
    },
    {
      "n": 2,
      "text": "No, it's not broken.",
      "schluessel": "broken",
      "anfang": 2.56,
      "ende": 3.96
    },
    {
      "n": 3,
      "text": "It moves exactly its own thickness, not a hair more.",
      "schluessel": "thickness",
      "anfang": 4.16,
      "ende": 7.72
    },
    {
      "n": 4,
      "text": "Hook it on a board and pull, it slides out,",
      "schluessel": "pull",
      "anfang": 8,
      "ende": 10.72
    },
    {
      "n": 5,
      "text": "and zero sits right where it touches the board.",
      "schluessel": "zero",
      "anfang": 10.8,
      "ende": 13.28
    },
    {
      "n": 6,
      "text": "But push it against a wall, it slides in,",
      "schluessel": "push",
      "anfang": 13.6,
      "ende": 16.56
    },
    {
      "n": 7,
      "text": "and zero sits right where it touches the wall.",
      "schluessel": "wall",
      "anfang": 16.64,
      "ende": 19.12
    },
    {
      "n": 8,
      "text": "So however you measure, its thickness never sneaks into the reading.",
      "schluessel": "never",
      "anfang": 19.44,
      "ende": 23.12
    },
    {
      "n": 9,
      "text": "Squeeze it tight, and one of the two will always come out wrong.",
      "schluessel": "wrong",
      "anfang": 23.6,
      "ende": 27.36
    },
    {
      "n": 10,
      "text": "So yes, it's loose, but on purpose.",
      "schluessel": "purpose",
      "anfang": 27.44,
      "ende": 30
    },
    {
      "n": 11,
      "text": "Send this to that friend who squeezed their tape measure hook thinking it was broken.",
      "schluessel": "friend",
      "anfang": 30.56,
      "ende": 34.56
    }
  ],
