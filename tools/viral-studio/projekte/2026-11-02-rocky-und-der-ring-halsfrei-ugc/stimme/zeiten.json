{
  "signatur": "0afef5481bd7",
  "dauer": 58.48,
  "saetze": [
    {
      "n": 1,
      "text": "Drei Jahre dachte ich: Rocky ist so.",
      "schluessel": "Rocky",
      "anfang": 0,
      "ende": 2.56
    },
    {
      "n": 2,
      "text": "Dann hab ich einen Ring getauscht.",
      "schluessel": "Ring",
      "anfang": 3.04,
      "ende": 4.72
    },
    {
      "n": 3,
      "text": "Jeder Gang war Armdrücken. Rocky hat gewonnen.",
      "schluessel": "Armdrücken",
      "anfang": 5.12,
      "ende": 8.24
    },
    {
      "n": 4,
      "text": "Raus nur noch, wenn keiner da war.",
      "schluessel": "keiner",
      "anfang": 8.64,
      "ende": 10.76
    },
    {
      "n": 5,
      "text": "Leckerli.",
      "schluessel": "Leckerli",
      "anfang": 10.96,
      "ende": 11.52
    },
    {
      "n": 6,
      "text": "Videos.",
      "schluessel": "Videos",
      "anfang": 11.84,
      "ende": 12.6
    },
    {
      "n": 7,
      "text": "Ein Halsband nach dem anderen.",
      "schluessel": "Halsband",
      "anfang": 12.8,
      "ende": 14.48
    },
    {
      "n": 8,
      "text": "Besser wurde es kaum.",
      "schluessel": "kaum",
      "anfang": 14.8,
      "ende": 16.2
    },
    {
      "n": 9,
      "text": "Bis ich sah, wo die Leine zieht.",
      "schluessel": "zieht",
      "anfang": 16.48,
      "ende": 18.24
    },
    {
      "n": 10,
      "text": "Bei uns: hinten am Rücken.",
      "schluessel": "Rücken",
      "anfang": 18.56,
      "ende": 20.32
    },
    {
      "n": 11,
      "text": "Da lehnt sich Rocky voll rein.",
      "schluessel": "rein",
      "anfang": 20.64,
      "ende": 22.64
    },
    {
      "n": 12,
      "text": "Ich dachte: Geschirr macht Zieher.",
      "schluessel": "Zieher",
      "anfang": 22.72,
      "ende": 24.72
    },
    {
      "n": 13,
      "text": "Stimmt – wenn sie hinten hängt.",
      "schluessel": "hinten",
      "anfang": 25.12,
      "ende": 26.8
    },
    {
      "n": 14,
      "text": "Vorne eingehakt, lenkt der Zug ihn zu mir.",
      "schluessel": "Vorne",
      "anfang": 27.28,
      "ende": 29.76
    },
    {
      "n": 15,
      "text": "Also HalsFrei: Ring vorne, gepolstert.",
      "schluessel": "HalsFrei",
      "anfang": 30.08,
      "ende": 33.36
    },
    {
      "n": 16,
      "text": "Über den Kopf, Klick, fertig.",
      "schluessel": "Klick",
      "anfang": 33.52,
      "ende": 35.52
    },
    {
      "n": 17,
      "text": "Erste Runde: ein Eichhörnchen.",
      "schluessel": "Eichhörnchen",
      "anfang": 35.92,
      "ende": 37.92
    },
    {
      "n": 18,
      "text": "Rocky startet – und landet bei mir.",
      "schluessel": "mir",
      "anfang": 38.08,
      "ende": 40.4
    },
    {
      "n": 19,
      "text": "Den Ruck federt die Ruckdämpfer-Leine ab.",
      "schluessel": "Ruckdämpfer-Leine",
      "anfang": 40.8,
      "ende": 43.16
    },
    {
      "n": 20,
      "text": "Heute sind unsere Runden entspannt.",
      "schluessel": "entspannt",
      "anfang": 43.36,
      "ende": 45.36
    },
    {
      "n": 21,
      "text": "Wir üben weiter – ohne Armdrücken.",
      "schluessel": "Armdrücken",
      "anfang": 45.52,
      "ende": 47.84
    },
    {
      "n": 22,
      "text": "Versand gratis, Größe tauschen, 30 Tage Geld zurück.",
      "schluessel": "gratis",
      "anfang": 48.08,
      "ende": 51.44
    },
    {
      "n": 23,
      "text": "Hältst du auch mit beiden Händen fest? Link unten.",
      "schluessel": "unten",
      "anfang": 51.76,
      "ende": 54.48
    },
    {
      "n": 24,
      "text": "Dabei lag's die ganze Zeit an einem Ring.",
      "schluessel": "Ring",
      "anfang": 54.88,
      "ende": 57.68
    }
  ],
