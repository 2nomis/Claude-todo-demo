{
  "signatur": "10c1a1b86b23",
  "dauer": 80.48,
  "saetze": [
    {
      "n": 1,
      "text": "Drei Jahre dachte ich, Rocky ist einfach so.",
      "schluessel": "Rocky",
      "anfang": 0,
      "ende": 2.96
    },
    {
      "n": 2,
      "text": "Dann hab ich einen Ring getauscht.",
      "schluessel": "Ring",
      "anfang": 3.44,
      "ende": 5.12
    },
    {
      "n": 3,
      "text": "Jeder Spaziergang war Armdrücken – und Rocky hat immer gewonnen.",
      "schluessel": "Armdrücken",
      "anfang": 5.52,
      "ende": 9.6
    },
    {
      "n": 4,
      "text": "Ich bin nur noch raus, wenn keiner unterwegs war.",
      "schluessel": "keiner",
      "anfang": 9.84,
      "ende": 12.36
    },
    {
      "n": 5,
      "text": "Leckerli.",
      "schluessel": "Leckerli",
      "anfang": 12.56,
      "ende": 13.12
    },
    {
      "n": 6,
      "text": "Videos.",
      "schluessel": "Videos",
      "anfang": 13.44,
      "ende": 14.28
    },
    {
      "n": 7,
      "text": "Ein Halsband nach dem anderen.",
      "schluessel": "Halsband",
      "anfang": 14.48,
      "ende": 16.16
    },
    {
      "n": 8,
      "text": "Besser wurde es kaum.",
      "schluessel": "kaum",
      "anfang": 16.4,
      "ende": 17.6
    },
    {
      "n": 9,
      "text": "Bis ich mir angeschaut hab, wo die Leine eigentlich zieht.",
      "schluessel": "zieht",
      "anfang": 18.08,
      "ende": 21.12
    },
    {
      "n": 10,
      "text": "Bei uns hing sie immer hinten am Rücken.",
      "schluessel": "Rücken",
      "anfang": 21.52,
      "ende": 23.68
    },
    {
      "n": 11,
      "text": "Und so kann sich Rocky voll reinlehnen – wie in ein Zuggeschirr.",
      "schluessel": "Zuggeschirr",
      "anfang": 23.84,
      "ende": 27.6
    },
    {
      "n": 12,
      "text": "Ich dachte immer: Mit Geschirr ziehen Hunde doch noch mehr.",
      "schluessel": "mehr",
      "anfang": 28,
      "ende": 31.2
    },
    {
      "n": 13,
      "text": "Stimmt – wenn die Leine hinten hängt.",
      "schluessel": "hinten",
      "anfang": 31.6,
      "ende": 33.76
    },
    {
      "n": 14,
      "text": "Vorne an der Brust eingehakt, lenkt ihn der Zug seitlich zu mir – statt nach vorn.",
      "schluessel": "seitlich",
      "anfang": 34.24,
      "ende": 38.96
    },
    {
      "n": 15,
      "text": "Also hab ich HalsFrei probiert: Ring vorne, gepolstert, mit Haltegriff.",
      "schluessel": "HalsFrei",
      "anfang": 39.44,
      "ende": 44.32
    },
    {
      "n": 16,
      "text": "Über den Kopf, Klick – fertig.",
      "schluessel": "Klick",
      "anfang": 44.72,
      "ende": 47.12
    },
    {
      "n": 17,
      "text": "Erste Runde: ein Eichhörnchen.",
      "schluessel": "Eichhörnchen",
      "anfang": 47.36,
      "ende": 49.44
    },
    {
      "n": 18,
      "text": "Rocky startet durch – und landet seitlich bei mir statt vorne in der Hecke.",
      "schluessel": "seitlich",
      "anfang": 49.84,
      "ende": 54.2
    },
    {
      "n": 19,
      "text": "Und der Ruck? Den federt die Ruckdämpfer-Leine ab.",
      "schluessel": "Ruckdämpfer-Leine",
      "anfang": 54.4,
      "ende": 57.52
    },
    {
      "n": 20,
      "text": "Heute sind unsere Runden viel entspannter.",
      "schluessel": "entspannter",
      "anfang": 57.92,
      "ende": 60.48
    },
    {
      "n": 21,
      "text": "Wir üben weiter – aber ohne Armdrücken.",
      "schluessel": "Armdrücken",
      "anfang": 60.64,
      "ende": 63.12
    },
    {
      "n": 22,
      "text": "Der Versand ist gratis, die Größe tauschst du einfach um – und du kannst es 30 Tage lang testen. Passt es nicht, gibt's dein Geld zurück.",
      "schluessel": "gratis",
      "anfang": 63.52,
      "ende": 71.84
    },
    {
      "n": 23,
      "text": "Wenn du auch mit beiden Händen festhältst: Schau's dir an. Der Link ist unten.",
      "schluessel": "unten",
      "anfang": 72.32,
      "ende": 76.68
    },
    {
      "n": 24,
      "text": "Dabei lag's die ganze Zeit an einem Ring.",
      "schluessel": "Ring",
      "anfang": 76.88,
      "ende": 79.68
    }
  ],
