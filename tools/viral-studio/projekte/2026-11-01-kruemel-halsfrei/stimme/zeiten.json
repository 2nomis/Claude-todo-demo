{
  "signatur": "ee2364cb11b9",
  "dauer": 66.16,
  "saetze": [
    {
      "n": 1,
      "text": "Kaum zu Hause, will ich nur noch raus aus dem Ding.",
      "schluessel": "raus",
      "anfang": 0,
      "ende": 3.44
    },
    {
      "n": 2,
      "text": "Damit ich nicht mehr so am Halsband zerre.",
      "schluessel": "Halsband",
      "anfang": 3.52,
      "ende": 5.36
    },
    {
      "n": 3,
      "text": "Gute Idee. Aber so richtig bequem war das Ding nie.",
      "schluessel": "bequem",
      "anfang": 5.84,
      "ende": 9.24
    },
    {
      "n": 4,
      "text": "Am Ring lag's nicht.",
      "schluessel": "Ring",
      "anfang": 9.44,
      "ende": 10.8
    },
    {
      "n": 5,
      "text": "Sondern an dem schmalen Riemchen vorne an meiner Brust.",
      "schluessel": "Riemchen",
      "anfang": 10.853,
      "ende": 13.72
    },
    {
      "n": 6,
      "text": "Bin ich losgestürmt, ist es dauernd verrutscht.",
      "schluessel": "verrutscht",
      "anfang": 13.92,
      "ende": 16.56
    },
    {
      "n": 7,
      "text": "Und unter den Vorderbeinen hat's ständig gezwickt.",
      "schluessel": "gezwickt",
      "anfang": 16.64,
      "ende": 19.2
    },
    {
      "n": 8,
      "text": "Spazierengehen? Ehrlich gesagt … eher so mittel.",
      "schluessel": "mittel",
      "anfang": 19.6,
      "ende": 23
    },
    {
      "n": 9,
      "text": "Frauchen hat's zigmal nachgestellt.",
      "schluessel": "nachgestellt",
      "anfang": 23.2,
      "ende": 25.36
    },
    {
      "n": 10,
      "text": "Aber ein schmales Riemchen bleibt ein schmales Riemchen.",
      "schluessel": "Riemchen",
      "anfang": 25.52,
      "ende": 28.6
    },
    {
      "n": 11,
      "text": "Was ich brauchte: ein breites, weiches Polster an der Brust.",
      "schluessel": "Polster",
      "anfang": 28.8,
      "ende": 32.8
    },
    {
      "n": 12,
      "text": "Da verteilt sich der Zug – und landet nicht am Hals.",
      "schluessel": "Hals",
      "anfang": 32.88,
      "ende": 35.68
    },
    {
      "n": 13,
      "text": "Und der Ring vorne lenkt mich beim Losziehen sanft zur Seite, zu Frauchen.",
      "schluessel": "Ring",
      "anfang": 35.76,
      "ende": 40.08
    },
    {
      "n": 14,
      "text": "So eins hat sie gefunden: HalsFrei.",
      "schluessel": "HalsFrei",
      "anfang": 40.2,
      "ende": 42.64
    },
    {
      "n": 15,
      "text": "Über den Kopf, Klick, fertig.",
      "schluessel": "Klick",
      "anfang": 42.68,
      "ende": 44.8
    },
    {
      "n": 16,
      "text": "Und mein Name steht drauf. Falls ich mal stiften geh.",
      "schluessel": "Name",
      "anfang": 44.88,
      "ende": 47.76
    },
    {
      "n": 17,
      "text": "Ziehen tu ich manchmal immer noch.",
      "schluessel": "Ziehen",
      "anfang": 47.8,
      "ende": 49.52
    },
    {
      "n": 18,
      "text": "Aber ich fühl mich drin wie in meiner Lieblingsdecke.",
      "schluessel": "Lieblingsdecke",
      "anfang": 49.56,
      "ende": 52.32
    },
    {
      "n": 19,
      "text": "Frauchen sagt: Der Versand ist gratis, die Größe tauschst du einfach um …",
      "schluessel": "gratis",
      "anfang": 52.4,
      "ende": 56.16
    },
    {
      "n": 20,
      "text": "… und du kannst es 30 Tage testen. Passt's nicht, gibt's das Geld zurück.",
      "schluessel": "Tage",
      "anfang": 56.608,
      "ende": 60.88
    },
    {
      "n": 21,
      "text": "Wenn dein Hund auch zieht: Schau's dir unten an.",
      "schluessel": "unten",
      "anfang": 60.96,
      "ende": 63.52
    },
    {
      "n": 22,
      "text": "Und alles fing damit an, dass …",
      "schluessel": "an",
      "anfang": 63.64,
      "ende": 65.36
    }
  ],
